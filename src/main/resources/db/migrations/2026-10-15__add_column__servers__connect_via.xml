<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="1"
               author="ssh-mcp">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="servers"
                              columnName="connect_via"/>
            </not>
        </preConditions>

        <addColumn tableName="servers">
            <column name="connect_via"
                    type="VARCHAR(255)"
                    remarks="Name of the server to reach this one through"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>