<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="1"
               author="ssh-mcp">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="executions_history"/>
            </not>
        </preConditions>

        <createTable tableName="executions_history">
            <column name="id"
                    type="BIGSERIAL"
                    autoIncrement="true">
                <constraints primaryKey="true"
                             primaryKeyName="pk_executions_history"
                             nullable="false"/>
            </column>

            <column name="session_id"
                    type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="name"
                    type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="server"
                    type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="command"
                    type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="result"
                    type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="exit_code"
                    type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="timed_out"
                    type="BOOLEAN"
                    defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="executed_at"
                    type="TIMESTAMP"
                    defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
