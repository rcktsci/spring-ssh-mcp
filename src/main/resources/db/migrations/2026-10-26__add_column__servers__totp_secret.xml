<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="1"
               author="ssh-mcp">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="servers"
                              columnName="totp_secret"/>
            </not>
        </preConditions>

        <addColumn tableName="servers">
            <column name="totp_secret"
                    type="TEXT"
                    remarks="Base32 TOTP-секрет (шифрованный) для авто-ответа на OTP"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
