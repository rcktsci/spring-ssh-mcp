<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="1"
               author="ssh-mcp">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="auth_tokens"
                              columnName="is_token_admin"/>
            </not>
        </preConditions>

        <addColumn tableName="auth_tokens">
            <column name="is_token_admin"
                    type="BOOLEAN"
                    defaultValueBoolean="false"
                    remarks="Permission to manage access tokens">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
